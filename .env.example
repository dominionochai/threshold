# Required — Featherless.AI key used by byllm to call
# meta-llama/Llama-3.1-8B-Instruct. Get a key at https://featherless.ai/.
FEATHERLESS_API_KEY=

# Optional — NVIDIA NIM key. Not used unless you swap default_model back
# to nvidia_nim/... in jac.toml. Leave blank to disable.
NVIDIA_NIM_API_KEY=

# Optional — server bindings. Defaults shown.
# JAC_SCALE_HOST=127.0.0.1
# JAC_SCALE_PORT=8001
# JAC_CLIENT_PORT=8000

# Optional — log verbosity: debug | info | warn | error.
# CIVICMESH_LOG_LEVEL=info
